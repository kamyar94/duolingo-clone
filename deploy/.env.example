# Lingo stack settings. Copy to .env next to docker-compose.yml. No secrets in this file: the
# tunnel token goes in cloudflared.env, the database password in db.env and the encryption key
# in ai.env. This file is also handed to the app container, so never put a token here.

# ---- Pinned versions (change these, then rebuild and restart, to update) ----
NODE_VERSION=24.22.1-alpine3.24
POSTGRES_VERSION=18.6-alpine3.24
CLOUDFLARED_VERSION=2026.10.0
SQUID_VERSION=7.2-26.04_edge

# ---- Address ----
# Used to print invite and reset links.
BASE_URL=https://learn.example.com

# ---- Sign-in ----
# Days a sign-in lasts on a device.
SESSION_DAYS=30
# Lock an account for LOGIN_LOCK_MINUTES after this many wrong passwords in a row.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- AI requests (math practice) ----
# Requests per account, counted by the app itself on top of the providers' own limits.
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=300
# How long one provider request may take, in milliseconds.
AI_REQUEST_TIMEOUT_MS=120000
