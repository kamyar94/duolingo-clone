# Database login, read by the db and app containers only. Copy to db.env, put the same long
# random password in both password lines, and lock the file. Do not change the password after
# the first start: the database keeps the old one.
POSTGRES_USER=lingo
POSTGRES_DB=lingo
POSTGRES_PASSWORD=change-me-to-a-long-random-password
PGUSER=lingo
PGDATABASE=lingo
PGPASSWORD=change-me-to-a-long-random-password
