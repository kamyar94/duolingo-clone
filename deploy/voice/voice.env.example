# Settings of the Lingo voice stack. Copy this file to .env in this folder (the name .env is
# ignored by git) and fill in the values. Nothing here is a real address or token.

# The address the Lingo server uses to reach the gateway: the workstation's local network
# address (reserved in the router so it does not change), or 127.0.0.1 for a test on the same
# machine. The gateway's certificate is made for exactly this value.
VOICE_HOST=192.0.2.10

# Where the gateway's port is published on the workstation. Use the same address as
# VOICE_HOST, or 0.0.0.0 to listen on every address. The default keeps the gateway reachable
# from the workstation itself only.
VOICE_BIND=127.0.0.1
VOICE_PORT=8443

# A long random token, at least 32 characters. The same value goes into the Lingo server's
# secrets file as VOICE_TOKEN. Make one in PowerShell with
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
# or in a Linux shell with  openssl rand -hex 32
VOICE_TOKEN=replace-with-64-random-hex-characters

# Two address ranges for the stack's networks. These two are reserved for documentation
# (RFC 5737), so no real network hands them out. Pick others only if something on the
# workstation already uses them (docker network ls and docker network inspect show the ones taken).
VOICE_SPEECH_SUBNET=198.51.100.0/24
VOICE_FRONT_SUBNET=203.0.113.0/24

# The Whisper model for speech to text. The setup job downloads it once; the Lingo server's
# VOICE_STT_MODEL must name the same model. Smaller and faster is Systran/faster-whisper-base.en.
WHISPER_MODEL=Systran/faster-whisper-small

# Seconds of silence after which the Whisper model leaves the GPU.
WHISPER_TTL=300

# Image versions. The defaults are the images this stack was tested with. Once it works on
# your machine, replace "latest" with a tag or a digest (docker image inspect shows it) so an
# update never arrives by surprise.
#KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest
#SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda
#CADDY_VERSION=2.11.7-alpine
