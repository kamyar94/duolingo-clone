# Secret of the code runners. Copy to runner.env and lock it like db.env. The app and every
# runner read it, and it never belongs in the app folder (a clone of the public repository).
#
# RUNNER_TOKEN is the shared token the app sends with every run. A runner refuses requests
# without it and refuses to start when it is shorter than 24 characters. Make one with
#   docker run --rm node:24.22.1-alpine3.24 node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RUNNER_TOKEN=
