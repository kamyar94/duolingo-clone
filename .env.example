# Settings for running outside Docker (pnpm dev). The Docker stack sets these in
# docker-compose.yml, .env and db.env instead.
NEXT_TELEMETRY_DISABLED="1"

PGHOST=localhost
PGUSER=lingo
PGPASSWORD=change-me
PGDATABASE=lingo

BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MEDIA_DIR=./media

# AI features (math practice). The base64 of 32 random bytes, made with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINGO_SECRET_KEY=
# Send provider requests through an HTTP proxy (the egress proxy in deploy/docker-compose.yml).
# AI_PROXY_URL=http://127.0.0.1:3128
# Point a provider at a local mock server (tests).
# AI_OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# AI_ANTHROPIC_BASE_URL=http://127.0.0.1:4010
# AI_GOOGLE_BASE_URL=http://127.0.0.1:4010/v1beta
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=300

# Code runners for C#, Java, Kotlin, C, C++, Go, Rust, Ruby, PHP, Perl, Lua and Bash
# (deploy/README.md). Without them those languages say that they cannot run here.
# RUNNER_TOKEN=a-random-value-of-at-least-24-characters
# RUNNER_URL_DOTNET=http://127.0.0.1:8081
# RUNNER_URL_JVM=http://127.0.0.1:8082
# RUNNER_RATE_PER_MINUTE=20
# RUNNER_RATE_PER_DAY=600

# Voice through the GPU computer (deploy/voice/README.md). Without VOICE_URL and VOICE_TOKEN
# the app shows no voice controls beyond the browser's own voice. Only a loopback gateway may
# use plain http. Any other address needs https, and VOICE_CA_FILE names the gateway's own root
# certificate. Narration audio is kept in VOICE_DATA_DIR (default ./.voice-data, gitignored).
# VOICE_URL=https://192.0.2.10:8443
# VOICE_TOKEN=
# VOICE_CA_FILE=/path/to/voice-ca/ca.pem
# VOICE_DATA_DIR=./.voice-data
# VOICE_CACHE_MAX_MB=512
