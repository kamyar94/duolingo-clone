# Settings for running outside Docker (pnpm dev). The Docker stack sets these in
# docker-compose.yml, .env and db.env instead.
NEXT_TELEMETRY_DISABLED="1"

PGHOST=localhost
PGUSER=lingo
PGPASSWORD=change-me
PGDATABASE=lingo

BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MEDIA_DIR=./media

# AI features (math practice). The base64 of 32 random bytes, made with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINGO_SECRET_KEY=
# Send provider requests through an HTTP proxy (the egress proxy in deploy/docker-compose.yml).
# AI_PROXY_URL=http://127.0.0.1:3128
# Point a provider at a local mock server (tests).
# AI_OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# AI_ANTHROPIC_BASE_URL=http://127.0.0.1:4010
# AI_GOOGLE_BASE_URL=http://127.0.0.1:4010/v1beta
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=300
