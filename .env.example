# Settings for running outside Docker (pnpm dev). The Docker stack sets these in
# docker-compose.yml, .env and db.env instead.
NEXT_TELEMETRY_DISABLED="1"

PGHOST=localhost
PGUSER=lingo
PGPASSWORD=change-me
PGDATABASE=lingo

BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MEDIA_DIR=./media
